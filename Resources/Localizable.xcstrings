        }
      }
    },
    "Your local LLM API key is invalid. Check it in Settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 LLM API 키가 올바르지 않아요. 설정에서 확인해 주세요."
