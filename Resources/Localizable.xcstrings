      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사 건너뛰기"
          }
        }
      }
    },
    "System Default": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 따르기"
          }
        }
      }
    },
    "Table": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표"
          }
        }
      }
    },
    "The %@ shortcut is in use by another app. Choose a different combination in Settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 단축키를 다른 앱이 쓰고 있어요. 설정에서 다른 조합을 골라 주세요."
          }
        }
      }
    },
    "The model declined to process this image. Try another engine.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 이 이미지의 처리를 거절했어요. 다른 엔진으로 다시 인식해 보세요."
          }
        }
      }
    },
    "The response is taking too long. Try recognizing again shortly.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 너무 오래 걸려요. 잠시 후 다시 인식해 주세요."
          }
        }
      }
    },
    "The result was too long to receive completely.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 너무 길어서 끝까지 받지 못했어요."
          }
        }
      }
    },
    "Too many requests right now. Try recognizing again shortly.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 몰려 잠시 처리할 수 없어요. 잠시 후 다시 인식해 주세요."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 취소"
          }
        }
      }
    },
