      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 이력…"
          }
        }
      }
    },
    "Can't connect to the local LLM server (%@). Start a local LLM server such as Nativ or Ollama.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 LLM 서버(%@)에 연결할 수 없어요. Nativ나 Ollama 같은 로컬 LLM 서버를 켜 주세요."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
