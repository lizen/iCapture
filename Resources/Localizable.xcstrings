      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 LLM 서버에 올라간 모델이 없어요. 이미지를 읽을 수 있는 모델을 올려 주세요."
          }
        }
      }
    },
    "No results": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 결과가 없어요"
          }
