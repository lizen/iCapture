{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %@s": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@초"
          }
        }
      }
    },
    "%lld fixed by check": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사로 수정 %lld곳"
          }
        }
      }
    },
    "%lld lines": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld line"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld lines"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld줄"
          }
        }
      }
    },
    "%lld to review": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 필요 %lld곳"
